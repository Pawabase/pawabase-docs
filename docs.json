{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Pawabase",
  "description": "Add sign-in, a database, file storage and live updates to your app.",
  "colors": {
    "primary": "#0d9488",
    "light": "#5eead4",
    "dark": "#2dd4bf"
  },
  "background": {
    "color": {
      "light": "#F7F7F5",
      "dark": "#06080b"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "weight": 500,
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 500
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search the docs…"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sillohq/pawabase"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://app.pawabase.com"
    }
  },
