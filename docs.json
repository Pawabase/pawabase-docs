    "primary": "#0d9488",
    "light": "#5eead4",
    "dark": "#2dd4bf"
  },
  "background": {
    "color": {
      "light": "#F7F7F5",
      "dark": "#06080b"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "weight": 500,
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 500
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
